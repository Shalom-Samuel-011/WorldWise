# Add these to backend/config.env for local development and to Render's
# environment settings for production. Create credentials in Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Use the same Google OAuth web client ID as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Resend SMTP settings for password reset emails.
# The API key can be supplied as RESEND_API_KEY or SMTP_PASS.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
RESEND_API_KEY=
# Alternatively, use SMTP_PASS instead of RESEND_API_KEY.
# SMTP_PASS=
# Use a sender address on a domain verified in Resend.
SMTP_FROM=WorldWise <noreply@your-verified-domain.com>
# Frontend origins used to build password reset links.
FRONTEND_URL_DEV=http://localhost:5173
FRONTEND_URL_PROD=https://world-wise-shalom23.vercel.app